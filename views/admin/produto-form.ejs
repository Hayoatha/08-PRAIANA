<!DOCTYPE html>
<html lang="pt-BR">
<head>
<%- include('../partials/head') %>
</head>
<body>
<div class="admin-topbar">
  <div class="container">
    <a href="/admin" class="marca">Painel · <%= site.nome %></a>
    <a href="/admin" style="font-size:0.85rem;">&larr; Voltar</a>
  </div>
</div>

<div class="admin-wrap">
  <div class="container">

    <% if (error && error.length) { %>
      <div class="alerta alerta-erro" style="max-width:720px;"><%= error[0] %></div>
    <% } %>

    <h1><%= produto ? 'Editar produto' : 'Novo produto' %></h1>

    <form class="form-produto" method="POST" enctype="multipart/form-data"
          action="<%= produto ? '/admin/produtos/' + produto.id + '/editar' : '/admin/produtos/novo' %>">

      <div class="form-grid">
        <div class="campo">
          <label for="nome">Nome da peça *</label>
          <input type="text" id="nome" name="nome" required value="<%= produto ? produto.nome : '' %>">
        </div>
        <div class="campo">
          <label for="categoria">Categoria</label>
          <select id="categoria" name="categoria">
            <% categorias.forEach(function(c) { %>
              <option value="<%= c %>" <%= produto && produto.categoria === c ? 'selected' : '' %>><%= c %></option>
            <% }) %>
          </select>
        </div>
      </div>

      <div class="campo">
        <label for="descricao">Descrição</label>
        <textarea id="descricao" name="descricao"><%= produto ? produto.descricao : '' %></textarea>
      </div>

      <div class="form-grid">
        <div class="campo">
          <label for="preco">Preço (R$) *</label>
          <input type="number" step="0.01" min="0" id="preco" name="preco" required value="<%= produto ? produto.preco : '' %>">
        </div>
        <div class="campo">
          <label for="precoPromocional">Preço promocional (R$)</label>
          <input type="number" step="0.01" min="0" id="precoPromocional" name="precoPromocional" value="<%= produto && produto.precoPromocional ? produto.precoPromocional : '' %>">
        </div>
      </div>

      <div class="campo">
        <label for="tamanhos">Tamanhos disponíveis (separados por vírgula)</label>
        <input type="text" id="tamanhos" name="tamanhos" placeholder="P, M, G"
               value="<%= produto && produto.tamanhos ? produto.tamanhos.join(', ') : '' %>">
      </div>

      <% if (produto && produto.imagens && produto.imagens.length) { %>
        <div class="campo">
          <label>Fotos atuais</label>
          <div class="imagens-atuais">
            <% produto.imagens.forEach(function(img) { %>
              <div class="imagem-atual">
                <img src="<%= img %>" alt="">
                <label>
                  <input type="checkbox" name="imagensRemover" value="<%= img %>">
                  Remover
                </label>
              </div>
            <% }) %>
          </div>
        </div>
      <% } %>

      <div class="campo">
        <label for="imagens">
          <%= produto ? 'Adicionar novas fotos' : 'Fotos da peça' %> (até 6, JPG/PNG/WEBP)
        </label>
        <input type="file" id="imagens" name="imagens" accept="image/*" multiple>
      </div>

      <div class="campo-check">
        <input type="checkbox" id="destaque" name="destaque" <%= produto && produto.destaque ? 'checked' : '' %>>
        <label for="destaque" style="margin:0;">Mostrar em destaque na página inicial</label>
      </div>

      <div class="campo-check">
        <input type="checkbox" id="ativo" name="ativo" <%= !produto || produto.ativo ? 'checked' : '' %>>
        <label for="ativo" style="margin:0;">Visível para clientes no site</label>
      </div>

      <button type="submit" class="btn btn-primary">
        <%= produto ? 'Salvar alterações' : 'Cadastrar produto' %>
      </button>
    </form>
  </div>
</div>
</body>
</html>
