<footer class="site-footer">
  <div class="container">
    <div>
      <h4><%= site.nome %></h4>
      <p style="max-width:260px; font-size:0.85rem; opacity:0.8;">Biquínis e moda praia feitos para valorizar cada mulher, com conforto e estilo.</p>
    </div>
    <div>
      <h4>Navegue</h4>
      <p><a href="/">Início</a></p>
      <p><a href="/catalogo">Catálogo</a></p>
    </div>
    <div>
      <h4>Contato</h4>
      <p><a href="https://wa.me/<%= site.whatsapp %>" target="_blank" rel="noopener">WhatsApp</a></p>
      <p><a href="<%= site.whatsappCatalogo %>" target="_blank" rel="noopener">Catálogo no WhatsApp</a></p>
      <p><a href="https://instagram.com/<%= site.instagram %>" target="_blank" rel="noopener">@<%= site.instagram %></a></p>
    </div>
    <div>
      <h4>Onde estamos</h4>
      <p style="max-width:220px; font-size:0.85rem;"><%= site.endereco %></p>
      <p><a href="<%= site.mapaUrl %>" target="_blank" rel="noopener">Ver no mapa</a></p>
    </div>
  </div>
  <div class="footer-bottom">
    &copy; <%= new Date().getFullYear() %> <%= site.nome %>. Todos os direitos reservados.
  </div>
</footer>

<div class="lightbox" id="lightbox" hidden>
  <button type="button" class="lightbox-fechar" id="lightboxFechar" aria-label="Fechar">&times;</button>
  <img src="" alt="" id="lightboxImg">
</div>

<script src="/js/main.js"></script>
