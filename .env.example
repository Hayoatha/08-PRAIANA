# Copie este arquivo para ".env" e ajuste os valores.
# Rode "npm run setup-admin" para gerar o hash da senha automaticamente.

PORT=3000
# Em produção: NODE_ENV=production e, atrás de proxy da hospedagem, TRUST_PROXY=1
# NODE_ENV=production
# TRUST_PROXY=1
SESSION_SECRET=troque-este-valor-por-um-texto-aleatorio-longo
ADMIN_USER=lana
ADMIN_PASS_HASH=

# Número do WhatsApp com código do país, sem espaços ou símbolos (ex: 5511999998888)
WHATSAPP_NUMERO=559296051474
# Link do catálogo da loja no WhatsApp Business
WHATSAPP_CATALOGO_URL=https://wa.me/c/559296051474
# Usuário do Instagram, sem o @
INSTAGRAM_USUARIO=praianabylana

# URL pública e definitiva do site, sem barra no final (usada no sitemap.xml
# e no robots.txt que você vai configurar no Google Search Console)
SITE_URL=https://www.praianabylana.com.br

# Opcional: pasta de um disco persistente para o catálogo sobreviver a cada
# deploy (produtos e fotos). Deixe comentado para desenvolvimento local — no
# Render essa variável já é definida sozinha (veja render.yaml).
# DATA_DIR=/var/data
